{
    extends: [
        'github>Userlane/tool-github-actions//.github/renovate.json5#master',
    ],
    // This repo mirrors upstream images and does not use the shared ci.yaml, so
    // the verdict flow that enables auto-merge elsewhere never runs here.
    packageRules: [
        {
            matchManagers: ['dockerfile'],
            matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
            automerge: true,
        },
        // Scoped to `action` so the preset's human-review rule for runner image
        // bumps (`runs-on: ubuntu-24.04`) still stands.
        {
            matchManagers: ['github-actions'],
            matchDepTypes: ['action'],
            matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
            automerge: true,
        },
    ],
}
